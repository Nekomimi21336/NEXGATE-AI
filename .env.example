# ===== NEXGATE AI 環境変数サンプル =====
# このファイルを .env にコピーし、実際の値に置き換えてください。
# シークレット類は必ず .env で管理し、system_config.json には保存しないでください。

# --- Flask / サーバー ---
FLASK_SECRET_KEY=CHANGE_ME
FLASK_DEBUG=1
FLASK_USE_RELOADER=0
FLASK_HOST=0.0.0.0
FLASK_PORT=5002
NEXGATE_APP_MODE=api
NEXGATE_INTERNAL_API_KEY=CHANGE_ME
# TypeScript 移行完了後のみ 1（不完全なバンドルで UI が壊れるのを防ぐ）
NEXGATE_VITE_ENABLED=0

# --- プロバイダー API キー（model_registry / image_generation_registry で参照） ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
BFL_API_KEY=
BFL_BASE_URL=https://api.bfl.ai

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- Discord OAuth ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5000/api/auth/discord/callback

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_PLUS_URL=
PAYPAL_PLAN_PRO_URL=
PAYPAL_PLAN_PRO_PLUS_URL=
PAYPAL_PLAN_MAX_URL=

# --- 検索エンジン ---
TAVILY_API_KEY=
TAVILY_MAX_CONCURRENT=2
SERPER_API_KEY=
SERPER_MAX_CONCURRENT=2
DDGS_BACKEND=
DDG_MAX_CONCURRENT=4

# --- メール (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_USE_SSL=0
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# --- 公開 URL / CORS ---
PUBLIC_BASE_URL=http://localhost:5000
PUBLIC_API_BASE_URL=http://localhost:5002
PUBLIC_API_CORS_ORIGIN=http://localhost:5000
FRONTEND_BASE_URL=http://127.0.0.1:5000
FRONTEND_PORT=5000
API_PORTAL_BASE_URL=http://127.0.0.1:5001
API_PORTAL_PORT=5001
API_INTERNAL_URL=http://127.0.0.1:5002
API_INTERNAL_WS_URL=

# --- OCR 依存関係 ---
NEXGATE_OCR_DEPS_QUIET=1
NEXGATE_SKIP_OCR_DEPS_INSTALL=1
# 起動時に pip install を自動実行する場合のみ 1
NEXGATE_OCR_AUTO_INSTALL=0

# --- その他 ---
COMPUTELAB_API_BASE=
COMPUTELAB_TOKEN_ENCRYPTION_KEY=
IMAGE_STORAGE_SECRET=
NEXGATE_MAX_CONCURRENT_V1=
SEARCH_CACHE_MAX=500
SEARCH_CACHE_TTL_SEC=3600
SEARCH_HTTP_TIMEOUT=20
SEARCH_FETCH_PAGE_TIMEOUT=20
SEARCH_FETCH_EXTRACT_MAX_CHARS=20000
SEARCH_FETCH_RAW_TEXT_CHARS=60000
SEARCH_POOL_WORKERS=4
WEB_FETCH_TEXT_CHARS=60000
WEB_SEARCH_MAX_ROUNDS=1
WEB_SEARCH_MAX_ROUNDS_SIMPLE=1
USD_JPY_RATE=150
